# App
# Local dev default: SQLite. For Postgres (staging/prod) point this at a PG
# database and switch the provider, then regenerate the client:
#   DATABASE_URL="postgres://pulse:pulse@localhost:5432/pulse"
#   ./scripts/use-db.sh postgres
# Bootstrap/migrate: prisma/postgres-baseline.sql (empty DB) or
# scripts/copy-sqlite-to-pg.py (schema + data from an existing dev.db).
DATABASE_URL="file:./dev.db"
JWT_SECRET=super-secret-key-change-in-production
REFRESH_SECRET=super-refresh-secret-change-in-production
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# Realtime state backend. Unset = in-process memory (single node, the dev
# default). Set for multi-node: shared match/queue/presence state + the
# Socket.IO Redis adapter (cross-node broadcasts).
# REDIS_URL=redis://localhost:6379

# Google OAuth 2.0 - https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID for a Web application, add http://localhost:4200 to Authorized JavaScript origins
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Uploaded images (profile/cover/chat media) live here on disk.
# In production point this at the Railway-mounted data volume, e.g. /data/uploads.
UPLOAD_DIR=/data/uploads
# Use Stripe TEST mode keys from https://dashboard.stripe.com/test/apikeys
# For local webhooks use the Stripe CLI: stripe listen --forward-to localhost:3000/api/v1/premium/webhook
# Leave STRIPE_SECRET_KEY blank to run checkout in dev mode (direct grant, no real payment).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:4200/premium
STRIPE_CANCEL_URL=http://localhost:4200/premium

# --- Security / platform additions (audit fixes) ---
# Apple Sign-In service identifier (used to verify identity tokens server-side)
APPLE_CLIENT_ID=
# Return OTP codes / reset tokens in API responses. Defaults: on in dev, off
# in production. Never enable in production — use Twilio/email providers.
DEV_AUTH_FALLBACK=
# SMS provider for phone OTP in production (codes are never returned in prod)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Allow guest account creation in production (off by default — each guest is
# a new DB row and a potential abuse vector)
ENABLE_GUEST_LOGIN=
# Extra CORS origins besides FRONTEND_URL (comma-separated)
APP_ORIGINS=
# Expose Swagger /docs in production (off by default)
SWAGGER_ENABLED=
# Global HTTP rate limit (requests/minute/identity, default 300)
RATE_LIMIT_MAX=
# Self-hosted TURN relay (coturn with static-auth-secret). When set, clients
# receive short-lived HMAC credentials from /api/v1/webrtc/turn-credentials.
TURN_URLS=
TURN_STATIC_AUTH_SECRET=
TURN_CREDENTIAL_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Realtime (Phase 2) & matchmaking (Phase 3) tunables — all optional; the
# defaults suit a single node. Only touch when tuning a specific deployment.
# ---------------------------------------------------------------------------
# Socket.IO native ping/pong liveness (ms). Dead sockets are disconnected
# within pingInterval+pingTimeout. Floors/enforces minimums in server.ts.
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=20000
# HTTP-level handshake/connect timeout (ms)
SOCKET_CONNECT_TIMEOUT_MS=10000
# Matchmaking queue sweeper interval (ms) — periodic rescan that pairs users
# the per-join scan (capped at 25 candidates) missed.
MATCH_QUEUE_SWEEP_MS=5000
# Fairness widening (ms of queue wait before preferences relax). Plain
# matching: gender roll relaxes after 10s. Premium-filter matching: the
# gender component relaxes after 15s, region filters after 30s.
MATCH_GENDER_RELAX_MS=10000
MATCH_FILTER_GENDER_RELAX_MS=15000
MATCH_FILTER_REGION_RELAX_MS=30000
